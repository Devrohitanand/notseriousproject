# ══════════════════════════════════════════════════════════════
#  STOLEBOOKS – Environment Variables
#
#  📌 HOW TO USE:
#  1. Copy this file: cp .env.example .env
#  2. Replace ALL "YOUR_..." values with your real credentials
#  3. NEVER commit the .env file to Git (it's in .gitignore)
# ══════════════════════════════════════════════════════════════

# ── Server ─────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# ── Frontend URL (for CORS) ────────────────────────────────────
# For local dev: http://localhost:3000
# For production: https://your-domain.com
FRONTEND_URL=http://localhost:3000

# ── MongoDB Database ───────────────────────────────────────────
# Option 1: Free cloud DB → https://mongodb.com/atlas
#   Steps:
#   1. Create account at mongodb.com/atlas
#   2. Create a free cluster
#   3. Click "Connect" → "Connect your application"
#   4. Copy the connection string and paste here
#
# Option 2: Local MongoDB
#   MONGODB_URI=mongodb://localhost:27017/stolebooks
#
MONGODB_URI=YOUR_DB_URI

# ── JWT Secret ────────────────────────────────────────────────
# This is used to sign and verify login tokens.
# Generate a strong random string. Example:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=YOUR_SUPER_SECRET_JWT_KEY_MIN_32_CHARS

# ── Razorpay Payment Gateway ──────────────────────────────────
# Get your keys from: https://dashboard.razorpay.com
# → Settings → API Keys → Generate Test Key
#
# For TEST mode (no real money): use keys starting with rzp_test_
# For LIVE mode (real money): use keys starting with rzp_live_
#
RAZORPAY_KEY_ID=YOUR_RAZORPAY_KEY_ID
RAZORPAY_KEY_SECRET=YOUR_RAZORPAY_SECRET

# Razorpay Webhook Secret
# → Razorpay Dashboard → Settings → Webhooks → Add webhook
# → URL: https://your-backend.com/api/payment/webhook
# → Secret: paste a random string here
RAZORPAY_WEBHOOK_SECRET=YOUR_WEBHOOK_SECRET

# ── Email Notifications (Nodemailer) ─────────────────────────
# Using Gmail:
#   1. Enable 2FA on your Google account
#   2. Go to: myaccount.google.com → Security → App Passwords
#   3. Create an App Password for "Mail"
#   4. Use that 16-character password as EMAIL_PASS
#
# NOTE: Do NOT use your real Gmail password!
EMAIL_USER=YOUR_EMAIL@gmail.com
EMAIL_PASS=YOUR_16_CHAR_APP_PASSWORD

# Admin email (will receive order notifications)
ADMIN_EMAIL=admin@stolebooks.com
